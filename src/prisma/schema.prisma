// This is your Prisma schema file for MCC Shop App
// Locally optimized for SQLite compatibility

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String?   @unique
  phone          String    @unique
  password       String
  role           String    @default("CUSTOMER") // Role: CUSTOMER, RIDER, ADMIN
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]
  rider          Rider?
  favorites      Favorite[]
  notifications  Notification[]
  savedAddresses SavedAddress[]
}

model Product {
  id            String       @id @default(uuid())
  skuCode       String       @unique
  name          String
  brand         String?
  category      String
  subCategory   String?
  unitSize      String
  costPrice     Float
  sellingPrice  Float
  vatIncluded   Boolean      @default(true)
  bulkThreshold Int          @default(0)
  bulkPrice     Float?
  stockQty      Int          @default(0)
  lowStockAlert Int          @default(5)
  dispatchMode  String       @default("BIKE") // DispatchMode: BIKE, VAN, PICKUP
  isFragile     Boolean      @default(false)
  isHazardous   Boolean      @default(false)
  images        String?      // SQLite doesn't support String[] - use JSON string
  notes         String?      // e.g. "colours:White,Magnolia,Ivory"
  isPublished   Boolean      @default(false)
  mvpPriority   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItems    OrderItem[]
  favorites     Favorite[]
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("PENDING") // OrderStatus: PENDING, CONFIRMED, DISPATCHED, DELIVERED, CANCELLED
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  vehicleType     String      // DispatchMode
  deliveryFee     Float       @default(0)
  subtotal        Float
  discount        Float       @default(0)
  couponCode      String?
  total           Float
  notes           String?
  scheduledAt     DateTime?
  riderId         String?
  rider           Rider?      @relation(fields: [riderId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payment         Payment?
  dispatchLog     DispatchLog?
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  method     String        // PaymentMethod: MOMO, CARD, BANK_TRANSFER, CASH
  status     String        @default("PENDING") // PaymentStatus: PENDING, SUCCESS, FAILED
  amount     Float
  reference  String?       @unique
  momoPhone  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Rider {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id])
  status      String      @default("OFFLINE") // RiderStatus: ONLINE, OFFLINE, ON_DELIVERY
  currentLat  Float?
  currentLng  Float?
  totalTrips  Int         @default(0)
  earnings    Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orders      Order[]
  dispatchLogs DispatchLog[]
}

model DispatchLog {
  id           String   @id @default(uuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id])
  riderId      String
  rider        Rider    @relation(fields: [riderId], references: [id])
  proofPhotoUrl String?
  signatureUrl  String?
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("ORDER") // ORDER, PROMO, SYSTEM
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SavedAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String   // e.g. "Home", "Site office"
  address   String
  landmark  String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  purpose   String   // REGISTER, RESET_PASSWORD
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String    // PERCENT, FIXED
  discountValue Float
  minOrderValue Float     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}
